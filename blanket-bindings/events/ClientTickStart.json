      "filter": { "loader:net.minecraftforge.event.TickEvent#phase:Lnet/minecraftforge/event/TickEvent$Phase;": "loader:net.minecraftforge.event.TickEvent$Phase#START:Lnet/minecraftforge/event/TickEvent$Phase;" } } },
