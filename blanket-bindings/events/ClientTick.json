{
  "schema": 1,
  "event": "CLIENT_TICK_END",
  "recipes": [
    { "when": { "loader": "legacy-fabric", "mc": "..1.13.2" }, "mixin": { "hook": "tick.end" } },
    { "when": { "loader": "fabric" }, "mixin": { "hook": "tick.end" } },
    { "when": { "loader": "forge", "mc": "1.8.9" },
      "native": { "event": "loader:net.minecraftforge.fml.common.gameevent.TickEvent$ClientTickEvent", "bus": "game", "filter": { "phase": "END" } } },
    { "when": { "loader": "forge", "mc": "1.20.1" },
      "native": { "event": "loader:net.minecraftforge.event.TickEvent$ClientTickEvent", "bus": "game", "filter": { "phase": "END" } } },
    { "when": { "loader": "neoforge", "mc": "1.21.1" },
      "native": { "event": "loader:net.neoforged.neoforge.client.event.ClientTickEvent$Post", "bus": "game" } }
  ]
}
